<Project>
  <!--
    Shared build settings for every project in the solution.

    Sherpa Manager is x64-only. The NVIDIA Surround support in
    src/Services/NvidiaSurroundService.cs binds nvapi64.dll directly, which a
    32-bit process cannot load, so the platform is pinned here rather than left
    to whichever configuration happens to be selected.
  -->
  <PropertyGroup>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Single source of truth for the product version. -->
  <PropertyGroup>
    <Version>0.4.7</Version>
    <AssemblyVersion>0.4.7.0</AssemblyVersion>
    <FileVersion>0.4.7.0</FileVersion>
    <InformationalVersion>0.4.7</InformationalVersion>
  </PropertyGroup>
</Project>
