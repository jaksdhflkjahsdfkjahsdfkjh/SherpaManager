<Window x:Class="SherpaManager.ActivationPreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review the switch" Width="660" Height="640" MinWidth="520" MinHeight="420"
        Icon="Assets/SherpaManager.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="HeadlineText" Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,18" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SectionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8"
                                Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,6,10,0"
                                                        VerticalAlignment="Top"
                                                        Background="{Binding Accent}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                               Foreground="{Binding Accent}"/>
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                               Visibility="{Binding DetailVisibility}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <CheckBox x:Name="SkipPreviewCheckBox" Content="Do not show this again"
                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button x:Name="ProceedButton" Style="{StaticResource PrimaryButton}"
                        Content="Switch now" IsDefault="True" Click="Proceed_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
