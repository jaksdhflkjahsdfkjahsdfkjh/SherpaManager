<Window x:Class="SherpaManager.ActivationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recent switches" Width="820" Height="600" MinWidth="640" MinHeight="420"
        Icon="Assets/SherpaManager.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Recent switches" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="8">
                <ListBox x:Name="SwitchList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="SwitchList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#201F28"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#299B8DFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Outcome at a glance, before reading anything. -->
                                <Border Background="{Binding Accent}" CornerRadius="2" Margin="0,2,0,2"/>

                                <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Top" Margin="9,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                <StackPanel Grid.Column="2" Margin="9,6,8,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Profile}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <Border Background="{StaticResource AccentSolidBrush}" CornerRadius="3"
                                                Padding="5,1" Margin="8,0,0,0"
                                                Visibility="{Binding NewestVisibility}">
                                            <TextBlock Text="newest" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding When}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{Binding Accent}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" CornerRadius="8"
                    Padding="14" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="DetailHeader" FontWeight="SemiBold" Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>
                        <ItemsControl x:Name="StepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Elapsed}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Right" Margin="0,1,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                               Foreground="{Binding Accent}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy" Click="Copy_Click" Margin="0,0,10,0"
                    ToolTip="Copy the selected switch as text, for a bug report."/>
            <Button Style="{StaticResource PrimaryButton}" Content="Close" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
