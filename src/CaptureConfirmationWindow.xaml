<Window x:Class="SherpaManager.CaptureConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Replace saved display layout?"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" Icon="Assets/SherpaManager.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Replace the saved layout?" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="ProfileText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,20"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="SAVED LAYOUT" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock x:Name="PreviousText"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    MaxHeight="96"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Margin="0,8,0,16"/>
                <TextBlock Text="CURRENT SETUP" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                <TextBlock x:Name="CapturedText"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    MaxHeight="96"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="This replaces the saved setup and its verification. Your monitors will not change. Test the new capture before switching."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0"/>
            <Button x:Name="ReplaceButton" Content="Replace saved layout" Style="{StaticResource PrimaryButton}" Click="Replace_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
