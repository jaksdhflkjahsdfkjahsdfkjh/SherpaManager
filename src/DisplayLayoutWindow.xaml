<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="clr-namespace:SherpaManager.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SherpaManager.DisplayLayoutWindow"
    Style="{StaticResource {x:Type Window}}"
    Title="Display layout"
    Width="820"
    MinWidth="600"
    MinHeight="420"
    Height="800"
    Icon="Assets/SherpaManager.ico"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
        <ui:PagedContent Grid.Row="1" Margin="0,20,0,20">
            <StackPanel>
                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="18" MinHeight="180">
                    <Grid>
                        <TextBlock x:Name="NoLayoutText"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <Canvas x:Name="LayoutCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Viewbox>
                    </Grid>
                </Border>
                <Border x:Name="SurroundCard"
                    Background="{StaticResource Surface2Brush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="NVIDIA SURROUND" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="SurroundList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="MonitorCard" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="MONITORS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="MonitorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap"
                                            Margin="16,0,0,0"
                                            Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:PagedContent>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="NVIDIA settings" Click="OpenNvidiaSettings_Click" ui:Icon.Data="{StaticResource IconExternal}" Margin="0,0,10,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Close" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
