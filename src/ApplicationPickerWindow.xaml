<Window x:Class="SherpaManager.ApplicationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SherpaManager.Controls"
        Style="{StaticResource {x:Type Window}}"
        Title="Add applications" Width="640" Height="620" MinWidth="520" MinHeight="420"
        Icon="Assets/SherpaManager.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Add applications" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Typing filters straight away, so the box is where the window opens. -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <TextBox x:Name="SearchBox" Padding="38,10,10,10" AutomationProperties.Name="Search installed applications" FontSize="14"
                     TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSearch}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
            <!-- An empty dark box gives no clue what it wants, and WPF has no
                 placeholder of its own. -->
            <TextBlock Text="Search installed applications" IsHitTestVisible="False"
                       Margin="40,0,0,0" FontSize="14" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ListBox x:Name="ResultList" Grid.Row="2" Margin="0,12,0,0"
                 Background="{StaticResource PanelBrush}"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectionChanged="ResultList_SelectionChanged"
                 MouseDoubleClick="ResultList_MouseDoubleClick"
                 KeyDown="ResultList_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="row" Background="Transparent" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- The icon arrives after the list does; until then the
                             row is complete without it. -->
                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"
                               VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="No applications match your search." Foreground="{StaticResource MutedTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ResultList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Choose a file…" Click="Browse_Click" ui:Icon.Data="{StaticResource IconFolder}" Margin="0,0,8,0"
                        ToolTip="For anything without a Start menu entry."/>
                <Button Content="Add empty row" Click="AddEmpty_Click" ui:Icon.Data="{StaticResource IconPlus}"
                        ToolTip="For a protocol address such as steam://rungameid/266410."/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="90"/>
                <Button x:Name="AddButton" Click="Add_Click" ui:Icon.Data="{StaticResource IconPlus}" MinWidth="120" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
