<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="clr-namespace:SherpaManager.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SherpaManager.MainWindow"
    Style="{StaticResource {x:Type Window}}"
    Title="Sherpa Manager"
    Width="1240"
    Height="956"
    MinWidth="900"
    MinHeight="480"
    Icon="Assets/SherpaManager.ico"
    Background="{StaticResource WindowBrush}"
    WindowStartupLocation="CenterScreen"
    Closing="Window_Closing"
    StateChanged="Window_StateChanged"
    PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="8,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/SherpaManager.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sherpa Manager" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="BY GRIDSHERPA" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="8,0,0,12">
                    <TextBlock Text="YOUR PROFILES"
                        Foreground="{StaticResource MutedTextBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>
                    <Button Content="+"
                        FontSize="20"
                        Width="32"
                        MinHeight="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        ToolTip="New profile"
                        AutomationProperties.Name="New profile"
                        Click="NewProfile_Click"/>
                </Grid>
                <ui:PagedContent Grid.Row="2">
                    <ListBox x:Name="ProfilesList"
                        Background="Transparent"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename" Click="RenameProfile_Click" />
                                <MenuItem Header="Duplicate" Click="DuplicateProfile_Click" />
                                <Separator />
                                <MenuItem Header="Delete" Click="DeleteProfile_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ProfileItem_PreviewMouseLeftButtonDown" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProfileItem_PreviewMouseRightButtonDown" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="12,14"
                                                BorderThickness="1"
                                                BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                                        <Path x:Name="ProfileGlyph"
                                            Style="{StaticResource SectionIcon}"
                                            Margin="0"
                                            Width="36"
                                            Height="36"
                                            StrokeThickness="2.4"
                                            Data="{StaticResource IconLayout}"/>
                                        <!-- The whole logo, transparent, in the same 36 px box as the
                                             other profiles' glyphs so the two read at the same width. -->
                                        <Border x:Name="RacingBadge" Padding="4" Visibility="Collapsed">
                                            <Image Source="Assets/iRacing-Stacked-Color-Blue.png"
                                                Stretch="Uniform"
                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <!-- The whole ACC wordmark at icon width. It is 3.17 times as wide as
                                             it is tall, so at 36 px it is a strip in which the white slashes read
                                             and the words do not; chosen over cropping to the emblem or widening
                                             this one row. -->
                                        <Border x:Name="AccBadge" Padding="4" Visibility="Collapsed">
                                            <Image Source="Assets/ACC-logo.png"
                                                Stretch="Uniform"
                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Applications.Count, StringFormat={}{0} apps}"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Name, Converter={StaticResource ProfileKindConverter}}" Value="Work">
                                        <Setter TargetName="ProfileGlyph" Property="Data" Value="{StaticResource IconWork}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Name, Converter={StaticResource ProfileKindConverter}}" Value="iRacing">
                                        <Setter TargetName="ProfileGlyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="RacingBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Name, Converter={StaticResource ProfileKindConverter}}" Value="ACC">
                                        <Setter TargetName="ProfileGlyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="AccBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ui:PagedContent>
                <StackPanel Grid.Row="3" Margin="0,20,0,0">
                    <Border Background="{StaticResource WindowBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="CURRENT MODE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                            <TextBlock x:Name="ActiveProfileText" Text="None active" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="Profile editor" ui:Icon.Data="{StaticResource IconLayout}" Click="ShowProfilePage_Click" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="0">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Settings" ui:Icon.Data="{StaticResource IconSettings}" Click="ShowSettingsPage_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="1">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="12,20,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" DataContext="{Binding ElementName=ProfilesList, Path=SelectedItem}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TabControl x:Name="MainTabs" SelectedIndex="0" Background="{StaticResource WindowBrush}" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem>
                    <ui:ResponsiveEditor x:Name="ProfilePage" Margin="20,20,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBox x:Name="ProfileNameBox"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    MaxLength="40"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Padding="0,0,0,6"
                                    AutomationProperties.Name="Profile name"
                                    ToolTip="Click to rename this profile."/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    TextWrapping="Wrap"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,4"
                                    Margin="0,4,0,0"
                                    MaxLength="120"
                                    AutomationProperties.Name="Profile description"
                                    ToolTip="Describe when you use this setup."/>
                            </StackPanel>
                            <Button x:Name="ActivateButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Content="Activate profile"
                                ui:Icon.Data="{StaticResource IconPlay}"
                                Click="ActivateProfile_Click"
                                VerticalAlignment="Top"
                                Margin="20,0,0,0"/>
                        </Grid>
                        <Grid x:Name="OverviewGrid" Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0" x:Name="DisplayCard" Grid.RowSpan="3">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconMonitor}" />
                                        <TextBlock Text="Display layout" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Save your monitor setup, then test it before switching."
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"
                                        Margin="0,6,0,12"/>
                                    <!-- A fixed two lines. It used to size to the summary, so a profile with a
                                         captured layout was a line taller than one without, and the application
                                         table lost a row whenever that profile was selected. -->
                                    <Border Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                                        Height="64">
                                        <TextBlock Text="{Binding DisplaySummary}"
                                            TextWrapping="Wrap"
                                            FontSize="13"
                                            MaxHeight="36"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding DisplaySummary}"/>
                                    </Border>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="NVIDIA Surround" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="SurroundModeCombo"
                                            Grid.Column="1"
                                            SelectedValuePath="Value"
                                            DisplayMemberPath="Label"
                                            AutomationProperties.Name="NVIDIA Surround mode"
                                            SelectedValue="{Binding NvidiaSurroundMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <WrapPanel Margin="0,0,-8,0">
                                        <Button Content="Capture current"
                                            Click="CaptureDisplay_Click"
                                            ui:Icon.Data="{StaticResource IconCapture}"
                                            Margin="0,0,8,8"/>
                                        <Button Content="View layout"
                                            Click="ViewDisplayLayout_Click"
                                            ui:Icon.Data="{StaticResource IconLayout}"
                                            Margin="0,0,8,8"/>
                                        <Button Content="Test layout" Click="TestDisplay_Click" ui:Icon.Data="{StaticResource IconPlay}" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,12,0,0">
                                        <UniformGrid Margin="0,0,-8,-8" Columns="2">
                                            <Button Content="Restore previous"
                                                Click="RestoreLastDisplay_Click"
                                                ui:Icon.Data="{StaticResource IconRestore}"
                                                Margin="0,0,8,8"
                                                ToolTip="Restore the saved emergency display snapshot."/>
                                            <Button Content="Clear saved"
                                                Click="ClearDisplay_Click"
                                                Margin="0,0,8,8"
                                                ToolTip="Remove the saved display layout from this profile."/>
                                            <Button Content="Windows settings"
                                                Click="OpenDisplaySettings_Click"
                                                ui:Icon.Data="{StaticResource IconExternal}"
                                                Margin="0,0,8,8"/>
                                            <Button Content="NVIDIA settings"
                                                Click="OpenNvidiaControlPanel_Click"
                                                ui:Icon.Data="{StaticResource IconExternal}"
                                                Margin="0,0,8,8"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0" x:Name="AudioCard" Grid.Column="2">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconAudio}" />
                                            <TextBlock Text="Audio devices" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <Button Content="Refresh"
                                            Click="RefreshAudioDevices_Click"
                                            ui:Icon.Data="{StaticResource IconRefresh}"
                                            Grid.Column="1"
                                            ToolTip="Refresh connected playback and recording devices."/>
                                    </Grid>
                                    <TextBlock Text="Default devices for this profile."
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"
                                        Margin="0,6,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Output" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                        <ComboBox x:Name="AudioOutputCombo"
                                            Grid.Column="1"
                                            DisplayMemberPath="Label"
                                            SelectedValuePath="Id"
                                            SelectionChanged="AudioOutput_SelectionChanged"
                                            AutomationProperties.Name="Audio output"/>
                                        <TextBlock Grid.Row="1"
                                            Text="Input"
                                            VerticalAlignment="Center"
                                            Margin="0,12,0,0"
                                            Foreground="{StaticResource MutedTextBrush}"/>
                                        <ComboBox x:Name="AudioInputCombo"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,12,0,0"
                                            DisplayMemberPath="Label"
                                            SelectedValuePath="Id"
                                            SelectionChanged="AudioInput_SelectionChanged"
                                            AutomationProperties.Name="Audio input"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0" x:Name="QuickCard" Grid.Column="2" Grid.Row="2">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconKeyboard}" />
                                        <TextBlock Text="Quick switching" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Switch from your keyboard or desktop."
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"
                                        Margin="0,6,0,12"/>
                                    <WrapPanel Margin="0,0,-8,-8">
                                        <Button x:Name="HotkeyButton"
                                            MinWidth="160"
                                            Margin="0,0,8,8"
                                            Click="HotkeyButton_Click"
                                            ui:Icon.Data="{StaticResource IconKeyboard}"
                                            PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                            LostFocus="HotkeyButton_LostFocus"
                                            ToolTip="Click, then press a shortcut such as Ctrl+Alt+W. Esc cancels; Backspace clears."/>
                                        <Button Content="Clear" Click="ClearHotkey_Click" Margin="0,0,8,8" />
                                        <Button Content="Desktop shortcut"
                                            Click="CreateShortcut_Click"
                                            ui:Icon.Data="{StaticResource IconExternal}"
                                            Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="HotkeyStatusText"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,0"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="ApplicationsCard" Style="{StaticResource Card}" Padding="16" Margin="0" Grid.Row="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconLayout}" />
                                        <TextBlock Text="Applications" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock Text="Launch in the order below. Each app waits for the previous one to start."
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        FontSize="12"
                                        Margin="0,8,0,8"/>
                                    <TextBlock x:Name="ApplicationIssuesText"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource CautionBrush}"
                                        Margin="0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <WrapPanel Margin="0,8,-8,4" Grid.Row="1">
                                    <Button Content="Add app"
                                        Click="AddApplication_Click"
                                        ui:Icon.Data="{StaticResource IconPlus}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,8"
                                        ToolTip="Search installed applications."/>
                                    <Button Content="Browse…" Click="BrowseApplication_Click" ui:Icon.Data="{StaticResource IconFolder}" Margin="0,0,8,8" />
                                    <Button Content="Remove" Click="RemoveApplication_Click" ui:Icon.Data="{StaticResource IconTrash}" Margin="0,0,16,8" />
                                    <Button x:Name="DragLockButton"
                                        Padding="10,8"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource DragLockButtonStyle}"
                                        Click="ToggleDragReorder_Click"
                                        AutomationProperties.Name="Toggle application drag reordering"
                                        MinWidth="108"/>
                                    <Button Content="↑"
                                        FontSize="18"
                                        Width="36"
                                        Padding="0"
                                        ToolTip="Move up"
                                        AutomationProperties.Name="Move application up"
                                        Click="MoveApplicationUp_Click"
                                        Margin="0,0,8,8"/>
                                    <Button Content="↓"
                                        FontSize="18"
                                        Width="36"
                                        Padding="0"
                                        ToolTip="Move down"
                                        AutomationProperties.Name="Move application down"
                                        Click="MoveApplicationDown_Click"
                                        Margin="0,0,8,8"/>
                                </WrapPanel>
                                <Grid Grid.Row="2">
                                    <DataGrid x:Name="ApplicationsGrid"
                                        ItemsSource="{Binding Applications}"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        AlternationCount="2"
                                        HeadersVisibility="All"
                                        RowHeaderWidth="30"
                                        CanUserSortColumns="False"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="ApplicationsGrid_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="ApplicationsGrid_PreviewMouseMove"
                                        DragOver="ApplicationsGrid_DragOver"
                                        Drop="ApplicationsGrid_Drop"
                                        RowHeaderStyle="{StaticResource ApplicationRowHeaderStyle}"
                                        SelectionMode="Single"
                                        MinHeight="100"
                                        RowEditEnding="ApplicationsGrid_RowEditEnding">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Use"
                                                Binding="{Binding Enabled}"
                                                Width="48"
                                                ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource DataGridCheckBoxStyle}"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                                            <DataGridCheckBoxColumn Header="Minimized"
                                                Binding="{Binding StartMinimized}"
                                                Width="92"
                                                ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource DataGridCheckBoxStyle}"/>
                                            <DataGridCheckBoxColumn Binding="{Binding CloseOnDeactivate}"
                                                Width="130"
                                                ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                                EditingElementStyle="{StaticResource DataGridCheckBoxStyle}">
                                                <DataGridCheckBoxColumn.Header>
                                                    <TextBlock Text="Close on switch"
                                                        ToolTip="Ask the app to exit when leaving this profile, then force close it if it does not respond."/>
                                                </DataGridCheckBoxColumn.Header>
                                            </DataGridCheckBoxColumn>
                                            <DataGridTextColumn Header="Executable or URL"
                                                Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"
                                                MinWidth="210"/>
                                            <DataGridTextColumn x:Name="DelayColumn" Header="Delay ms" Binding="{Binding LaunchDelayMs}" Width="92">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,44,16,16" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ApplicationsGrid}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Your companion apps, ready to go" FontWeight="SemiBold" TextAlignment="Center" />
                                        <TextBlock Text="Add apps to build this profile’s launch sequence."
                                            Foreground="{StaticResource MutedTextBrush}"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center"
                                            Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </ui:ResponsiveEditor>
                </TabItem>
                <TabItem>
                    <Grid x:Name="SettingsPage" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="Make Sherpa work the way you do."
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}"
                                FontSize="12"
                                Margin="0,8,0,24"/>
                        </StackPanel>
                        <ui:PagedContent Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconSettings}" />
                                            <TextBlock Text="Window &amp; startup" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="Keep Sherpa close at hand and choose how it starts."
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            Margin="0,8,0,16"/>
                                        <CheckBox x:Name="CloseToTrayCheckBox"
                                            Content="Keep Sherpa running in the tray when I close its window"
                                            Checked="SettingsCheckBox_Changed"
                                            Unchecked="SettingsCheckBox_Changed"/>
                                        <TextBlock Text="Closing can keep Sherpa in the notification area. The tray’s Exit command always closes it."
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            Margin="26,6,0,16"/>
                                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                            Content="Start Sherpa Manager when Windows starts"
                                            Checked="SettingsCheckBox_Changed"
                                            Unchecked="SettingsCheckBox_Changed"/>
                                        <!-- Only meaningful for the launch Windows makes, so it follows the
                                             startup choice above rather than standing on its own. -->
                                        <CheckBox x:Name="StartMinimizedCheckBox"
                                            Content="Start minimized"
                                            Margin="26,10,0,0"
                                            IsEnabled="{Binding IsChecked, ElementName=StartWithWindowsCheckBox}"
                                            ToolTip="When Windows starts Sherpa, it opens in the tray if it is kept there, or minimized on the taskbar otherwise."
                                            Checked="SettingsCheckBox_Changed"
                                            Unchecked="SettingsCheckBox_Changed"/>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Activate at startup" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                            <ComboBox Grid.Column="1"
                                                x:Name="StartupProfileCombo"
                                                DisplayMemberPath="Label"
                                                SelectedValuePath="Value"
                                                SelectionChanged="StartupProfileCombo_SelectionChanged"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconShield}" />
                                            <TextBlock Text="Display safety" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="Review changes and keep a way back to your previous setup."
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            Margin="0,8,0,16"/>
                                        <CheckBox x:Name="ConfirmDisplayChangesCheckBox"
                                            Content="Show a 10-second rollback timer the first time a new layout is applied"
                                            Checked="SettingsCheckBox_Changed"
                                            Unchecked="SettingsCheckBox_Changed"/>
                                        <Border Height="12" />
                                        <CheckBox x:Name="ShowActivationPreviewCheckBox"
                                            Content="Show what a profile switch will change before it runs"
                                            Checked="SettingsCheckBox_Changed"
                                            Unchecked="SettingsCheckBox_Changed"/>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Wait for displays to settle, at most"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="0,0,16,0"/>
                                            <TextBox Grid.Column="1"
                                                x:Name="DisplaySettleDelayBox"
                                                MaxLength="6"
                                                LostFocus="DisplaySettleDelay_LostFocus"
                                                ToolTip="Sherpa watches the desktop after the monitors change and starts applications as soon as it stops moving. This is the longest it will wait, not the time it always waits."/>
                                            <TextBlock Grid.Column="2" Text="ms" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconLayout}" />
                                            <TextBlock Text="Application launch" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="Wait for each app to be ready before starting the next."
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            Margin="0,8,0,16"/>
                                        <TextBlock Text="Before starting the next app, wait for"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="LaunchReadinessCombo"
                                                DisplayMemberPath="Label"
                                                SelectedValuePath="Value"
                                                SelectionChanged="LaunchReadiness_SelectionChanged"
                                                ToolTip="Applications Sherpa cannot track, such as scripts and protocol URLs, are never waited for."/>
                                            <TextBlock Grid.Column="1"
                                                Text="up to"
                                                Margin="16,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBox Grid.Column="2"
                                                x:Name="LaunchReadinessTimeoutBox"
                                                MaxLength="6"
                                                LostFocus="LaunchReadinessTimeout_LostFocus"/>
                                            <TextBlock Grid.Column="3" Text="ms" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="16" />
                                        <CheckBox x:Name="ShowLaunchDelaysCheckBox"
                                            Content="Show the per-application launch delay column"
                                            ToolTip="A fixed delay is only needed for scripts, protocol URLs, and other targets Sherpa cannot detect."
                                            Checked="SettingsCheckBox_Changed"
                                            Unchecked="SettingsCheckBox_Changed"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIcon}" Data="{StaticResource IconCopy}" />
                                            <TextBlock Text="Diagnostics &amp; profile data" Style="{StaticResource SectionTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="Copy a redacted system report or open your saved profiles."
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            Margin="0,8,0,16"/>
                                        <WrapPanel Margin="0,0,-8,-8">
                                            <Button Content="Copy diagnostics"
                                                Click="CopyDiagnostics_Click"
                                                ui:Icon.Data="{StaticResource IconCopy}"
                                                Margin="0,0,8,8"
                                                ToolTip="Paths and command-line arguments are redacted."/>
                                            <Button Content="Open profile file"
                                                Click="OpenProfileFile_Click"
                                                ui:Icon.Data="{StaticResource IconFolder}"
                                                Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </ui:PagedContent>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                        Text="Ready"
                        FontSize="12"
                        Foreground="{StaticResource MutedTextBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,16,0"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button Content="Recent switches"
                        Click="ShowActivationHistory_Click"
                        ui:Icon.Data="{StaticResource IconHistory}"
                        Grid.Column="1"
                        Padding="10,6"
                        ToolTip="Review recent profile switches, step by step."/>
                    <ProgressBar x:Name="BusyProgress"
                        Grid.ColumnSpan="2"
                        IsIndeterminate="True"
                        Height="3"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-12"
                        Visibility="Collapsed"
                        Foreground="{StaticResource AccentBrush}"
                        Background="Transparent"/>
                </Grid>
            </Border>
            <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#B0131218" Visibility="Collapsed" Panel.ZIndex="5">
                <Border Width="390"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True"
                            Height="4"
                            Margin="0,0,0,18"
                            Foreground="{StaticResource AccentBrush}"
                            Background="{StaticResource Surface2Brush}"/>
                        <TextBlock Text="Working on your profile" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="BusyOperationText"
                            Text="Please wait…"
                            Margin="0,9,0,20"
                            Foreground="{StaticResource MutedTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"/>
                        <Button x:Name="BusyCancelButton"
                            Content="Cancel"
                            Click="CancelBusyOperation_Click"
                            HorizontalAlignment="Center"
                            MinWidth="120"
                            ToolTip="Cancel this operation and restore the previous state"
                            AutomationProperties.Name="Cancel current operation"/>
                        <TextBlock Text="You can also press Esc"
                            Margin="0,10,0,0"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
