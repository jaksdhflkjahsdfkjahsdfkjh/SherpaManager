<Window x:Class="SherpaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sherpa Manager" Width="1180" Height="860" MinWidth="1000" MinHeight="820"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="2,4,0,22">
                    <TextBlock Text="S H E R P A" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="SIM RIG MANAGER" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="1,2,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="PROFILES" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="＋" Width="34" Height="30" Padding="0" HorizontalAlignment="Right" ToolTip="New profile" Click="NewProfile_Click"/>
                </Grid>
                <ListBox x:Name="ProfilesList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ProfilesList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,7"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,11">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#201F28"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#299B8DFF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="4" Height="30" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Applications.Count, StringFormat={}{0} apps}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="7" Padding="10" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="CURRENT MODE" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                            <TextBlock x:Name="ActiveProfileText" Text="None active" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Profile editor" Click="ShowProfilePage_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <Button Content="Settings" Click="ShowSettingsPage_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource WindowBrush}" DataContext="{Binding ElementName=ProfilesList, Path=SelectedItem}">
            <TabControl x:Name="MainTabs" SelectedIndex="0" Background="{StaticResource WindowBrush}" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"/>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem>
            <ScrollViewer Background="{StaticResource WindowBrush}" VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="34,28,34,42">
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="28" FontWeight="Bold"
                                     Background="Transparent" BorderThickness="0" Padding="0" MaxLength="40"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource MutedTextBrush}"
                                     Background="Transparent" BorderThickness="0" Padding="0" Margin="2,7,0,0" MaxLength="120"/>
                        </StackPanel>
                        <Button x:Name="ActivateButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="ACTIVATE PROFILE"
                                Click="ActivateProfile_Click" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </Grid>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="DISPLAY LAYOUT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="Capture the monitor setup you want for this profile, then test it."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="175"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NVIDIA Surround" Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="SurroundModeCombo" Grid.Column="1"
                                          SelectedValuePath="Value" DisplayMemberPath="Label"
                                          SelectedValue="{Binding NvidiaSurroundMode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <UniformGrid Columns="3" Rows="2" Margin="-4,12,-4,-4">
                                <Button Content="Capture current" Click="CaptureDisplay_Click" Margin="4"/>
                                <Button Content="Test layout" Click="TestDisplay_Click" Margin="4"/>
                                <Button Content="Clear saved" Click="ClearDisplay_Click" Margin="4"/>
                                <Button Content="Restore previous" Click="RestoreLastDisplay_Click" Margin="4"/>
                                <Button Content="Windows settings" Click="OpenDisplaySettings_Click" Margin="4"/>
                                <Button Content="NVIDIA settings" Click="OpenNvidiaControlPanel_Click" Margin="4"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="APPLICATIONS" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Apps launch from top to bottom. Drag-free ordering keeps switches predictable."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Content="↑" Width="36" Padding="0,9" ToolTip="Move up" Click="MoveApplicationUp_Click" Margin="0,0,6,0"/>
                            <Button Content="↓" Width="36" Padding="0,9" ToolTip="Move down" Click="MoveApplicationDown_Click" Margin="0,0,8,0"/>
                            <Button Content="Browse…" Click="BrowseApplication_Click" Margin="0,0,8,0"/>
                            <Button Content="Remove" Click="RemoveApplication_Click" Margin="0,0,8,0"/>
                            <Button Content="＋ Add app" Click="AddApplication_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ApplicationsGrid" ItemsSource="{Binding Applications}" AutoGenerateColumns="False" CanUserAddRows="False"
                              AlternationCount="2"
                              SelectionMode="Single" MinHeight="210" MaxHeight="350" RowEditEnding="ApplicationsGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Enabled}" Width="48"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridCheckBoxColumn Header="Minimized" Binding="{Binding StartMinimized}" Width="76"/>
                            <DataGridCheckBoxColumn Binding="{Binding CloseOnDeactivate}" Width="125">
                                <DataGridCheckBoxColumn.Header>
                                    <TextBlock Text="Close on switch"
                                               ToolTip="Ask the app to exit when leaving this profile, then force close it if it does not respond."/>
                                </DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Executable or URL" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="210"/>
                            <DataGridTextColumn Header="Delay ms" Binding="{Binding LaunchDelayMs}" Width="76">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14" Margin="0,16,0,20">
                        <Grid>
                            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                            <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed"
                                         Foreground="{StaticResource AccentBrush}" Background="Transparent"/>
                        </Grid>
                    </Border>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Duplicate profile" Click="DuplicateProfile_Click" Margin="0,0,8,0"/>
                            <Button Content="Delete profile" Click="DeleteProfile_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="34,28,34,42">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,25">
                            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Choose how Sherpa behaves."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="2,7,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="WINDOW" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14"/>
                                <CheckBox x:Name="CloseToTrayCheckBox" Content="Keep Sherpa running in the tray when I close its window"
                                          Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" Margin="0,0,0,9"/>
                                <TextBlock Text="On: hide to the notification area. Off: exit Sherpa completely."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="20,-4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISPLAY SAFETY" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ConfirmDisplayChangesCheckBox"
                                              Content="Show a 10-second rollback timer the first time a new layout is applied"
                                              Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open profile file" Click="OpenProfileFile_Click"
                                        VerticalAlignment="Center" Margin="24,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border x:Name="BusyOverlay" Background="#70131218" Visibility="Collapsed" Panel.ZIndex="5"/>
        </Grid>
    </Grid>
</Window>
