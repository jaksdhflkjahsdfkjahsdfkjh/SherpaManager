<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="clr-namespace:SherpaManager.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SherpaManager.DisplayConfirmationWindow"
    Style="{StaticResource {x:Type Window}}"
    Title="Keep this display layout?"
    Width="560"
    SizeToContent="Height"
    MaxHeight="600"
    ResizeMode="NoResize"
    Icon="Assets/SherpaManager.ico"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ShowInTaskbar="True"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Can you see and use this layout?" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Sherpa will automatically restore the previous monitor layout unless you keep this one."
                Foreground="{StaticResource MutedTextBrush}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="14" Margin="0,20,0,20">
            <StackPanel>
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="CountdownText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,9,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Revert now" IsCancel="True" Click="Revert_Click" ui:Icon.Data="{StaticResource IconRestore}" Margin="0,0,10,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Keep layout" Click="Keep_Click" />
        </StackPanel>
    </Grid>
</Window>
